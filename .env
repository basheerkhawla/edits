# ── 4. TON DIRECT PAYMENT ───────────────────────────────────────────────
# محفظة TON التي يُرسل إليها العميل مباشرةً (Mainnet — تبدأ بـ EQ أو UQ)
TON_WALLET_ADDRESS=UQDbsOzujo9HIfs9Da2EMuO3D1QYSjCKMuHlOhbfi_4M53Jj
# 1 TON = كم دولار؟ (حدّثه يدوياً أو اربطه بـ CoinGecko API)
