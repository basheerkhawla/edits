# مدة صلاحية جلسة الدفع بالدقائق (افتراضي: 30)
TON_INVOICE_EXPIRY_MINUTES=30

# ── 5. SECURITY ─────────────────────────────────────────────────────────
# مفتاح JWT — عشوائي وطويل (32+ حرف)
# لتوليده: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-this-with-64-random-characters-now

# كلمة سر لوحة المشرف /admin/*
ADMIN_SECRET=choose-a-very-strong-password

# ── 6. SITE ─────────────────────────────────────────────────────────────
# رابط الموقع — يُستخدم في Cryptomus callback و روابط الإحالة
# يجب أن يطابق Callback URL المسجّل في Cryptomus Dashboard
SITE_URL=https://Tele-starz.com

# ── 7. WITHDRAWAL ───────────────────────────────────────────────────────
# true = يُرسل النجوم فوراً عند طلب السحب (عبر Fragment)
# false = يبقى معلقاً حتى تضغط /admin/approve-withdrawal/{id}
AUTO_WITHDRAW=false

# ── NEW — Telegram Channel (زر القناة في الموقع) ──────────────────────────
# رابط قناة تيليجرام الخاصة بك — يظهر في شريط التنقل
TELEGRAM_CHANNEL_URL=https://t.me/Tele_starz

TONAPI_KEY=AHU6X2YECF2MCWIAAAAFCO7OJU2JGB3FOTSLH7ENLLSDIR4X7CPL6UZVQFZ75IQLSCVRBNQ


